# ---- Database ----------------------------------------------------------
# A Neon branch. Neon shows two connection strings for every branch; both are
# needed, and they are not interchangeable.
#
# DATABASE_URL is the POOLED one, whose hostname carries `-pooler`. The API,
# the pipeline and the scoring scripts use it. On Railway it is sealed in the
# api service's variables rather than composed; see .railway/railway.ts.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_UNPOOLED is the DIRECT one, the same hostname without `-pooler`.
# `make migrate` and the other migrate-* targets prefer it when it is set. The
# runner holds a session-level advisory lock so two runners queue rather than
# interleave, and PgBouncer's transaction mode hands each statement whatever
# server connection is free, so over the pooler the lock guards nothing. Leave
# it empty against the container, where there is no pooler to avoid.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Seconds the API waits for the first connection before serving /health with
# the database reported unavailable. A Neon branch that has scaled to zero takes
# a moment to wake; raise this if a cold start is being reported as an outage.
DB_CONNECT_TIMEOUT=5

# The optional local container (`make up`), for offline work. CI uses the same
# image. To use it, point DATABASE_URL at
#   postgresql://clearskies:clearskies@localhost:5432/clearskies
# and leave DATABASE_URL_UNPOOLED empty.
POSTGRES_USER=clearskies
POSTGRES_PASSWORD=clearskies
POSTGRES_DB=clearskies

# Host port for the local container. Change if 5432 is already in use,
# and update DATABASE_URL to match.
POSTGRES_PORT=5432

# The database the PostGIS-backed API tests run against (`make test-spatial`
# sets it from DATABASE_URL). Unset, those tests skip. They seed inside a
# transaction and roll it back, so a development branch is left as it was.
CLEARSKIES_TEST_DATABASE_URL=

# ---- API ---------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# "json" in a deploy, where Railway indexes the fields; "text" for a readable
# line in a terminal. See api/app/logging_config.py.
LOG_FORMAT=text

# Pilot state. Locked in Phase 0, see docs/methodology.md section 4.
PILOT_STATE=LA

# ---- Ingestion credentials ---------------------------------------------
# OpenAQ v3 rejects unauthenticated requests. Free keys are issued at
# https://explore.openaq.org/register. Without one the OpenAQ adapter reports a
# failed pull with a legible reason and the other sources run normally.
OPENAQ_API_KEY=
# The Census API requires a key on every data query; without one the ACS
# adapter fails immediately rather than loading a partial map. Free and
# instant from https://api.census.gov/data/key_signup.html.
CENSUS_API_KEY=

# ---- Drafting assistant ------------------------------------------------
# Without a key the API runs normally and the draft endpoint returns 503.
#
# Set the hard monthly spend cap on this key in the OpenAI dashboard, not in
# the application. A limit the application enforces is one that stops working
# when the application has a bug. docs/drafting.md section 8.
OPENAI_API_KEY=

# The model that writes drafts and judges citations.
DRAFT_MODEL=gpt-4o
# Pinned to the corpus: changing it without re-embedding puts vectors from two
# models in one space. See docs/corpus.md section 5.
EMBEDDING_MODEL=text-embedding-3-small

# ---- Rate limits (CS-402) ----------------------------------------------
#
# Both are per client, in this process's memory, and configurable without a
# redeploy. Two replicas allow twice the limit and a restart forgets the
# counts, so these bound one client's burst rather than the deployment's
# exposure. The limit that cannot be got round is the provider spend cap
# above. Zero or less turns either off. See api/app/rate_limit.py.

# Drafts spend money, and no human writes ten an hour.
DRAFT_RATE_LIMIT=10
DRAFT_RATE_WINDOW_S=3600

# Reads cost a database query. Loose on purpose: opening a panel is one
# request and a reader clicking around the map must not run into this. It
# bounds what one client can do to the database, not what anyone may see --
# the data is public. /health is never limited, because the uptime check
# polls it and it has to answer while everything else is refusing.
READ_RATE_LIMIT=600
READ_RATE_WINDOW_S=60

# ---- Frontend (Vite; only VITE_ prefixed vars reach the browser) -------
VITE_API_BASE_URL=http://localhost:8000
# The PMTiles archive, served from Cloudflare R2 rather than from the frontend
# service. It is one large object read with HTTP Range requests, which an edge
# cache keyed on whole URLs handles badly, and R2 does not bill egress.
# infra/r2/README.md has the bucket setup and the CORS policy.
VITE_TILES_URL=https://tiles.example.com/clearskies-la.pmtiles
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Search-to-location. Photon is the default and needs no key; set this to point
# at a self-hosted instance. Not Nominatim: its usage policy requires a
# descriptive User-Agent that a browser will not let the page set.
# See docs/frontend.md section 5.
VITE_GEOCODER_URL=https://photon.komoot.io/api

# ---- Tile hosting (CS-207; only the deploy step reads these) -----------
# An R2 API token scoped to the tiles bucket. Nothing in the application reads
# them, because nothing in the application writes tiles.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=clearskies-tiles
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The frontend origin `make check-tiles` asks the bucket's CORS policy about.
# Defaults to the Vite dev server; set it to the deployed web domain to check
# the real thing.
TILES_ORIGIN=http://localhost:5173
