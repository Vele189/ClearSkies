# Copy to .env and fill in what you need. Phase 0 needs nothing filled in:
# every variable below has a working local default.
#
# .env is gitignored and must stay that way. What each variable does, where
# else it has to be set, and what breaks without it: docs/secrets.md.

# ---- Database ----------------------------------------------------------
# Local development points at the docker-compose service.
# On Railway this is injected as ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=postgresql://clearskies:clearskies@localhost:5432/clearskies

POSTGRES_USER=clearskies
POSTGRES_PASSWORD=clearskies
POSTGRES_DB=clearskies

# Host port for the local container. Change if 5432 is already in use,
# and update DATABASE_URL to match.
POSTGRES_PORT=5432

# ---- API ---------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Pilot state. Locked in Phase 0, see docs/methodology.md section 4.
PILOT_STATE=LA

# ---- Drafting assistant (optional in Phase 0) --------------------------
# Without a key the API runs normally and the draft endpoint returns 503.
ANTHROPIC_API_KEY=

# ---- Ingestion adapters (read in Phase 1, unused in Phase 0) -----------
# Only two of the five sources authenticate. EPA ECHO, TRI via Envirofacts,
# and AirToxScreen are unauthenticated and need nothing here.
#
# The nightly job also needs these as GitHub Actions secrets; see
# docs/secrets.md. Both are free.

# https://explore.openaq.org/register — required by the v3 API on every request.
OPENAQ_API_KEY=

# https://api.census.gov/data/key_signup.html — without it the ACS pull is
# capped at roughly 500 requests a day, which is not enough for a full run.
CENSUS_API_KEY=

# ---- Frontend (Vite; only VITE_ prefixed vars reach the browser) -------
# Everything here is compiled into the bundle and is public. Never put a
# credential behind a VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8000
VITE_TILES_URL=https://tiles.example.com/clearskies-la.pmtiles
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
