{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // "node" is here for the one test that reads Tailwind's shipped palette
    // off disk to check contrast; nothing under src/ that ships to the browser
    // imports a node module, and the bundler would fail if it did.
    "types": ["vite/client", "node"],
    // shadcn generates its components against "@/", and rewriting each one to
    // a relative path on the way in is how a later `shadcn add` produces a
    // file that does not compile. Everything else in src/ keeps its relative
    // imports; the alias is for the ui/ directory's own convention.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
