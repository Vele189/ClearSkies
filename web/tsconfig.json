{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // "node" is here for the one test that reads Tailwind's shipped palette
    // off disk to check contrast; nothing under src/ that ships to the browser
    // imports a node module, and the bundler would fail if it did.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
