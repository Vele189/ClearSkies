# Rendered to /etc/nginx/conf.d/default.conf at container start; ${PORT} is the
# only substitution (see the Dockerfile's NGINX_ENVSUBST_FILTER).

server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # Vite writes hashed filenames for everything under assets/, so a stale copy
    # is impossible: a changed file is a changed URL. index.html is the one file
    # whose name never changes, and a cached copy of it pins the browser to the
    # previous build's asset names, which then 404 after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/css text/javascript application/javascript application/json
                      image/svg+xml application/geo+json;

    # The app routes client-side, so any path that is not a file on disk has to
    # come back as the shell rather than as a 404. =404 on the last fallback
    # would defeat that; the shell itself renders the app's own not-found page.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Nothing here serves the tile archive: it is one large object read with
    # Range requests, and it lives in R2 behind VITE_TILES_URL. See
    # infra/r2/README.md for why it is not co-located with the app.

    access_log /dev/stdout;
    error_log  /dev/stderr warn;
}
