# The frontend's own settings, for the web repository, where this directory is
# the repository root and there is no parent .env to symlink to.
#
# In the monorepo this file is redundant: web/.env is a symlink to the root
# .env, and ../.env.example is the combined list. Keep the two in step.
#
# Only VITE_ prefixed variables reach the browser, and Vite inlines them AT
# BUILD TIME. Changing one means rebuilding -- `npm run build` locally, or a
# new image, since the Dockerfile takes each of these as a build arg. Nothing
# here is a secret for that reason: whatever is set is readable in the bundle.

# Where the API is. The client joins this onto a path, so it needs the scheme.
VITE_API_BASE_URL=http://localhost:8000

# The PMTiles archive, served from Cloudflare R2 rather than from this service:
# it is one large object read with HTTP Range requests, which an edge cache
# keyed on whole URLs handles badly, and R2 does not bill egress. The bucket's
# CORS policy has to name this app's origin.
VITE_TILES_URL=https://tiles.example.com/clearskies-la.pmtiles

# Free, no key, no attribution beyond the basemap's own.
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Search-to-location. Left empty, the search box takes coordinates and H3
# indexes and nothing is sent to a third party. Photon needs no key; not
# Nominatim, whose usage policy requires a descriptive User-Agent that a
# browser will not let the page set.
VITE_GEOCODER_URL=

# Read by the container, not by the application: the port nginx listens on.
PORT=8080
