# The API service's own settings, for the api repository, where this directory
# is the repository root and there is no parent .env to symlink to.
#
# In the monorepo this file is redundant: api/.env is a symlink to the root
# .env, and ../.env.example is the combined list covering the pipeline and the
# frontend too. Keep the two in step -- a variable added to app/config.py
# belongs in both. Nothing checks that automatically yet; docs/repos.md
# section 5 says why not.
#
# Every value below is read by api/app/config.py. A setting left out falls back
# to the default in that file, which is the local container in every case.

# ---- Database ----------------------------------------------------------
# The POOLED connection string (hostname carries `-pooler`). The API opens many
# short connections and the pooler is what they are for.
DATABASE_URL=postgresql://clearskies:clearskies@localhost:5432/clearskies

# The DIRECT one, for the migration runner only: its advisory lock is
# session-level and PgBouncer's transaction mode does not hold it. Empty
# against the local container, which has no pooler. See app/migrate.py.
DATABASE_URL_UNPOOLED=

# Seconds to wait for the first connection before serving /health with the
# database reported unavailable. A Neon branch scaled to zero takes a moment to
# wake; raise this if a cold start is being reported as an outage.
DB_CONNECT_TIMEOUT=5

# Set to run the PostGIS-backed tests (`pytest tests/test_hex_detail_sql.py`).
# Unset, they skip. They seed inside a transaction and roll it back.
CLEARSKIES_TEST_DATABASE_URL=

# ---- Service -----------------------------------------------------------
# Comma-separated origins allowed to call this API. The deployed frontend's
# origin must be here or the browser blocks every response.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# "json" in a deploy, where the platform indexes the fields; "text" for a
# readable line in a terminal. See app/logging_config.py.
LOG_FORMAT=text
# Locked in Phase 0. See docs/methodology.md section 4 in the main repository.
PILOT_STATE=LA

# ---- Drafting assistant ------------------------------------------------
# Without a key the API runs normally and /draft returns 503.
#
# Set the hard monthly spend cap on this key in the OpenAI dashboard, not here.
# A limit the application enforces is one that stops working when the
# application has the bug that calls the API in a loop.
OPENAI_API_KEY=
DRAFT_MODEL=gpt-4o
# Pinned to the corpus: changing it without re-embedding puts vectors from two
# models in one space, which returns quietly worse retrievals rather than
# failing.
EMBEDDING_MODEL=text-embedding-3-small

# ---- Rate limits -------------------------------------------------------
# Per client, in this process's memory. Two replicas allow twice the limit and
# a restart forgets the counts, so these bound one client's burst rather than
# the deployment's exposure. Zero or less turns either off.
DRAFT_RATE_LIMIT=10
DRAFT_RATE_WINDOW_S=3600
READ_RATE_LIMIT=600
READ_RATE_WINDOW_S=60

# ---- The local database container --------------------------------------
# Read by docker-compose.yml, not by the application.
POSTGRES_USER=clearskies
POSTGRES_PASSWORD=clearskies
POSTGRES_DB=clearskies
POSTGRES_PORT=5432
